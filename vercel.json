{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?:pdfix-tools|pdf-galaxy-pro)\\.vercel\\.app"
        },
        {
          "type": "query",
          "key": "tool",
          "value": "(?<toolSlug>merge|split|compress|rotate|image-to-pdf|pdf-to-image|pdf-to-word|add-page-numbers|watermark|protect|extract-text|ocr|qr-generator|delete-pages|reorder-pages|extract-pages|crop|sign|edit-pdf)"
        }
      ],
      "destination": "https://pdfix-tools.vercel.app/tools/:toolSlug",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pdf-galaxy-pro.vercel.app"
        }
      ],
      "destination": "https://pdfix-tools.vercel.app/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "pdf-galaxy-pro.vercel.app"
        }
      ],
      "destination": "https://pdfix-tools.vercel.app/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
